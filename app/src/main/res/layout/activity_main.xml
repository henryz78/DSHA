<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical">
  <!-- 顶栏与底部标签由 MainChrome（miuix）绘制。 -->
  <androidx.compose.ui.platform.ComposeView android:id="@+id/app_bar" android:layout_width="match_parent" android:layout_height="wrap_content" />
  <TextView android:id="@+id/environment_recovery_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="12dp" android:textColor="@color/primary" android:background="@drawable/bg_chip_clickable" android:textSize="14sp" android:clickable="true" android:focusable="true" android:visibility="gone" android:gravity="center" android:includeFontPadding="false" />
  <FrameLayout android:id="@+id/fragment_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
  <androidx.compose.ui.platform.ComposeView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
