<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:orientation="vertical" android:paddingBottom="@dimen/gap_control">
    <!-- 顶栏（标题与后台任务）、工具按钮与终端标签由 TerminalChrome（miuix）绘制。 -->
    <androidx.compose.ui.platform.ComposeView android:id="@+id/terminal_header" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginStart="@dimen/page_pad" android:layout_marginEnd="@dimen/page_pad" android:layout_weight="1" android:background="@drawable/bg_terminal" android:padding="@dimen/gap_tight">
        <com.termux.view.TerminalView android:id="@+id/pty_view" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/terminal_surface" android:focusable="true" android:focusableInTouchMode="true" />
        <TextView android:id="@+id/pty_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="@string/ui_m0145" android:textColor="@color/text_muted" android:visibility="gone" />
    </FrameLayout>
    <androidx.compose.ui.platform.ComposeView android:id="@+id/pty_keys" android:layout_width="match_parent" android:layout_marginStart="@dimen/page_pad" android:layout_marginEnd="@dimen/page_pad" android:layout_height="wrap_content" />
</LinearLayout>
