<?xml version="1.0" encoding="utf-8"?>
<!-- miuix 开关轨道：开为主色，关为浅灰；禁用时降低不透明度。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.4" android:color="@color/primary" android:state_checked="true" android:state_enabled="false" />
    <item android:alpha="0.4" android:color="@color/switch_track_off" android:state_enabled="false" />
    <item android:color="@color/primary" android:state_checked="true" />
    <item android:color="@color/switch_track_off" />
</selector>
